# Aplicacao
APPNOME=Gestao de Franquias API
APPVERSAO=1.0.0
APPENV=development
DEBUG=true

# Banco de dados (use 'postgres' como host quando rodar via docker-compose)
POSTGRESHOST=postgres
POSTGRESPORT=5432
POSTGRESDB=gestao-franquias
POSTGRESUSER=postgres
POSTGRESPASSWORD=postgres

# JWT
SECRETKEY=coloque-uma-chave-segura
ALGORITHM=HS256
ACCESSTOKENEXPIREMINUTES=60

# Gateway mock de pagamento
PAGAMENTOMOCKTAXAAPROVACAO=0.8
